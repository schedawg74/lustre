{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/vitest"
  ],
  "files": {
    "includes": [
      "!!**/.output",
      "!!**/.wxt",
      "!!**/dist",
      "!!**/.turbo",
      "!!pnpm-lock.yaml",
      "!!bts.jsonc",
      "!!src/packages/db/migrations/meta"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      "style": {
        "noMagicNumbers": "off",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useNamingConvention": "off",
        "useFilenamingConvention": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "useTopLevelRegex": "off",
        "noJsxPropsBind": "off",
        "noAwaitInLoops": "off"
      },
      "suspicious": {
        "noImportCycles": "error",
        "noUnnecessaryConditions": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/apps/extension/e2e/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noMisplacedAssertion": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/apps/server/src/routers/**",
        "src/apps/server/src/middleware/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@lustre/db": "Routers and middleware call services. They do not access the database.",
                  "@lustre/db/schema": "Routers and middleware call services. They do not access the database.",
                  "@lustre/db/testing": "Routers and middleware call services. They do not access the database.",
                  "drizzle-orm": "Routers and middleware call services. They do not access the database.",
                  "better-sqlite3": "Routers and middleware call services. They do not access the database."
                },
                "patterns": [
                  {
                    "group": ["drizzle-orm/*"],
                    "message": "Routers and middleware call services. They do not access the database."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/packages/infra/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@lustre/*"],
                    "message": "Infrastructure code imports no workspace code."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
