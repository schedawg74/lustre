{
  "name": "@feedwarden/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Personal feed control for X: bulk-block lists, one-click block, mute and not interested.",
  "type": "module",
  "scripts": {
    "build": "wxt build && wxt build -b firefox --mv3",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3"
  },
  "dependencies": {
    "@feedwarden/block-queue": "workspace:*",
    "@feedwarden/x-client": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wxt-dev/module-react": "1.2.2",
    "typescript": "catalog:",
    "wxt": "0.21.5"
  }
}
