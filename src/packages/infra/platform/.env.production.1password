# 1Password references for the `production` stack. No value in this file is a
# secret; `op` resolves the references. See ../README.md.
#
# The Pulumi CLI reads these variables:
#   op run --env-file=.env.production.1password -- pulumi preview --stack production
PULUMI_BACKEND_URL=s3://lustre-pulumi-state?endpoint=nbg1.your-objectstorage.com&region=nbg1
PULUMI_CONFIG_PASSPHRASE=op://lustre-infra/pulumi/PULUMI_CONFIG_PASSPHRASE
AWS_ACCESS_KEY_ID=op://lustre-infra/pulumi-state/AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=op://lustre-infra/pulumi-state/AWS_SECRET_ACCESS_KEY
HCLOUD_TOKEN=op://lustre-infra/hetzner/HCLOUD_TOKEN

# ../scripts/sync-secrets.sh copies these into the encrypted stack config.
STACK_TAILSCALE_AUTH_KEY=op://lustre-infra/tailscale/HOST_AUTH_KEY
STACK_BACKUP_BUCKET=op://lustre-infra/litestream/BUCKET
STACK_BACKUP_ACCESS_KEY_ID=op://lustre-infra/litestream/ACCESS_KEY_ID
STACK_BACKUP_SECRET_ACCESS_KEY=op://lustre-infra/litestream/SECRET_ACCESS_KEY
